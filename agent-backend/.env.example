# ── LLM 配置（OpenAI 兼容接口）─────────────────────────────────────

LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-max



# ── 本地代理（可选：转发到 vveai / 本地 Mac 代理）───────────────────
# 如果 AgentScope 在其他机器上，填写 Mac 的代理地址
# LLM_API_KEY=any
# LLM_BASE_URL=http://localhost:8005/v1

# ── 服务端口 ─────────────────────────────────────────────────────────
AGENT_PORT=8001

# ── sale-demo 数据库（转发线索用） ───────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=anvil_demo
DB_USER=postgres
DB_PASSWORD=change-me

# ── DuckDuckGo 搜索（web_search 工具，无需 API key）─────────────────
# 留空即可，使用内置的 httpx 请求

# ── Langfuse 智能体监控与评估 ───────────────────────────────────────
# 在 Langfuse 项目设置中创建 API keys 后填入。不要提交真实 key。
LANGFUSE_BASE_URL=
LANGFUSE_PROJECT_ID=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACE_SAMPLE_RATE=1.0
LANGFUSE_REDACT_PII=true

# 知识库版本，留空时会按 knowledge/*.md 的文件名、mtime、size 自动生成 hash
KB_VERSION=
