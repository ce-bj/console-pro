        "path": "/api/kb/website-profile"
      },
      "queryParams": [
        "siteId"
      ]
    },
    {
      "name": "mockSitesData",
      "shape": "array",
      "endpoint": {
        "method": "GET",
        "path": "/api/kb/portal-sites"
      }
    }
  ],
  "actions": [
